rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function canSendFriendRequest(userId) {
      let previous = resource.data.friendRequests;
      let next = request.resource.data.friendRequests;
      return signedIn()
        && request.auth.uid != userId
        && changedOnly(['friendRequests'])
        && previous is list
        && next is list
        && next.size() == previous.size() + 1
        && next.hasAll(previous)
        && next[next.size() - 1].fromUid == request.auth.uid;
    }

    function canChangeOwnLinkInAnotherProfile(userId) {
      let previous = resource.data.friends;
      let next = request.resource.data.friends;
      let addedSelf = next.size() == previous.size() + 1
        && next.hasAll(previous)
        && next.hasAny([request.auth.uid]);
      let removedSelf = next.size() == previous.size() - 1
        && previous.hasAll(next)
        && previous.hasAny([request.auth.uid])
        && !next.hasAny([request.auth.uid]);
      return signedIn()
        && request.auth.uid != userId
        && changedOnly(['friends'])
        && previous is list
        && next is list
        && (addedSelf || removedSelf);
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /games/{gameId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /pushSubs/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /publicProfiles/{profileId} {
      allow read: if true;
      allow create, update: if isOwner(profileId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'username',
          'displayName',
          'photoURL',
          'level',
          'uid',
          'gamesData',
          'updatedAt'
        ]);
      allow delete: if isOwner(profileId);
    }

    match /socialProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId)
        || canSendFriendRequest(userId)
        || canChangeOwnLinkInAnotherProfile(userId);
      allow delete: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && changedOnly(['lastMessage', 'lastMessageAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'senderUid',
            'senderName',
            'senderPhoto',
            'text',
            'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 120
          && (request.resource.data.senderPhoto == null
            || (request.resource.data.senderPhoto is string
              && request.resource.data.senderPhoto.size() <= 2048));
        allow update, delete: if false;
      }
    }

    match /collabLists/{listId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
